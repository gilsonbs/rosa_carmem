# ------------------------------------------------------------
# Supabase
# URL e chave anônima (pública) do projeto — Settings > API
# ------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# Mercado Pago
# ------------------------------------------------------------

# Chave pública (client-side) — usada no frontend para o Checkout Pro
VITE_MERCADOPAGO_PUBLIC_KEY=

# Access token (server-side apenas!) — NUNCA expor com prefixo VITE_
# Usado pelo backend Node para criar preferências e validar pagamentos
MERCADOPAGO_ACCESS_TOKEN=

# Secret usado para validar a assinatura dos webhooks (Dia 4)
MERCADOPAGO_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Backend (server/) — Node/Express
# ------------------------------------------------------------

# Chave service_role do Supabase (Settings > API) — NUNCA expor no frontend
SUPABASE_SERVICE_ROLE_KEY=

# Porta do servidor Express local
SERVER_PORT=3001

# URL do frontend (usada nos back_urls do Mercado Pago)
FRONTEND_URL=http://localhost:5173

# URL pública da API (usada no notification_url do webhook)
API_URL=http://localhost:3001
